<div class="t20bm-tabuleiro" style="{{estiloFundo}}">
	<div class="t20bm-aviso-modal" role="status" aria-live="polite"></div>
	<div class="t20bm-tabuleiro-conteudo">

		{{!-- ============ Cabeçalho ============ --}}
		<header class="t20bm-cabecalho">
			<div class="t20bm-cabecalho-titulo">
				<span class="t20bm-sobretitulo">{{tamanho}}</span>
				<h1>{{#if nome}}{{nome}}{{else}}{{localize "T20BM.Gerenciador.SemNome"}}{{/if}}</h1>
				{{#if local}}<span class="t20bm-local">{{localize "T20BM.Modal.Local"}}: {{local}}</span>{{/if}}
			</div>
			<div class="t20bm-cabecalho-direita">
				{{#if gm}}
				<div class="t20bm-controles-mestre">
					{{#if exibida}}
					<button type="button" data-action="encerrar" data-tooltip="T20BM.Modal.EncerrarDica"><i class="fa-solid fa-eye-slash"></i> {{localize "T20BM.Gerenciador.Encerrar"}}</button>
					{{else}}
					<span class="t20bm-previa-aviso"><i class="fa-solid fa-user-secret"></i> {{localize "T20BM.Modal.SoVoce"}}</span>
					<button type="button" data-action="exibir"><i class="fa-solid fa-play"></i> {{localize "T20BM.Gerenciador.Exibir"}}</button>
					{{/if}}
					<button type="button" class="t20bm-icone" data-action="configurar" data-tooltip="T20BM.Gerenciador.Configurar"><i class="fa-solid fa-gear"></i></button>
					<button type="button" class="t20bm-icone" data-action="fecharLocal" data-tooltip="T20BM.Modal.FecharParaMim"><i class="fa-solid fa-xmark"></i></button>
				</div>
				{{/if}}
				<span class="t20bm-turno">{{rotuloTurno}}</span>
			</div>
		</header>

		{{#if fim}}
		{{!-- ============ Resultado da batalha ============ --}}
		<section class="t20bm-fim {{fim.lado}}">
			<div class="t20bm-fim-titulo">
				<span class="t20bm-sobretitulo">{{localize "T20BM.Fim.Resultado"}} · {{fim.turnosTxt}}</span>
				<h2>{{fim.titulo}}</h2>
				<p>{{fim.tipoTxt}}</p>
			</div>
			<div class="t20bm-fim-placar">
				{{#each exercitos}}
				<div class="t20bm-fim-exercito {{lado}} {{#if (eq @index @root.fim.vencedor)}}vencedor{{/if}}">
					<span class="t20bm-sobretitulo">{{nome}}</span>
					<strong>{{pontos}}</strong>
					{{#if (eq @index @root.fim.vencedor)}}<i class="fa-solid fa-trophy"></i>{{/if}}
				</div>
				{{/each}}
			</div>
			<div class="t20bm-fim-blocos">
				<div class="t20bm-fim-bloco">
					<span class="t20bm-sobretitulo">{{localize "T20BM.Fim.Baixas"}}</span>
					<ul>{{#each fim.baixas}}<li><b>{{exercito}}</b> {{texto}}</li>{{/each}}</ul>
				</div>
				<div class="t20bm-fim-bloco">
					<span class="t20bm-sobretitulo">{{localize "T20BM.Fim.Herois"}}</span>
					{{#if fim.recompensa}}<p>{{fim.recompensa}}</p>{{/if}}
					{{#if fim.derrotaHerois}}<p>{{fim.derrotaHerois}}</p>{{/if}}
				</div>
			</div>
			{{#if fim.historico.length}}
			<div class="t20bm-fim-bloco">
				<span class="t20bm-sobretitulo">{{localize "T20BM.Fim.Historico"}}</span>
				<table class="t20bm-historico">
					<thead><tr><th>{{localize "T20BM.Fim.Turno"}}</th><th>{{localize "T20BM.Fim.Rolagens"}}</th><th>{{localize "T20BM.Fim.Vencedor"}}</th><th>{{localize "T20BM.Fim.Pontos"}}</th><th>{{localize "T20BM.Fim.Placar"}}</th></tr></thead>
					<tbody>{{#each fim.historico}}<tr><td>{{turno}}</td><td>{{totaisTxt}}</td><td>{{vencedorNome}}</td><td>+{{pontos}}</td><td>{{placarTxt}}</td></tr>{{/each}}</tbody>
				</table>
			</div>
			{{/if}}
			{{#if gm}}
			<footer class="t20bm-fim-acoes">
				<button type="button" data-action="reiniciarBatalha"><i class="fa-solid fa-rotate-left"></i> {{localize "T20BM.Gerenciador.Reiniciar"}}</button>
				{{#if exibida}}<button type="button" class="t20bm-principal" data-action="encerrar"><i class="fa-solid fa-eye-slash"></i> {{localize "T20BM.Gerenciador.Encerrar"}}</button>{{/if}}
			</footer>
			{{/if}}
		</section>
		{{else}}
		{{!-- ============ Exércitos ============ --}}
		<section class="t20bm-exercitos-painel">
			{{#each exercitos}}
			{{#if @index}}<div class="t20bm-versus" aria-hidden="true">&#x2694;&#xFE0E;</div>{{/if}}
			<article class="t20bm-cartao-exercito {{lado}}">
				<header class="t20bm-cartao-exercito-topo">
					<div>
						<span class="t20bm-sobretitulo">{{#if @index}}{{localize "T20BM.Configurador.ExercitoInimigo"}}{{else}}{{localize "T20BM.Configurador.SeuExercito"}}{{/if}}</span>
						<h2>{{nome}}</h2>
					</div>
					<div class="t20bm-pontos">
						<span class="t20bm-pontos-valor">{{pontos}}</span>
						<span class="t20bm-sobretitulo">{{localize "T20BM.Modal.Pontos"}}</span>
					</div>
				</header>

				<div class="t20bm-comando">
					{{#if general}}
					<img class="t20bm-token general {{#if general.podeVer}}clicavel{{/if}}" src="{{general.img}}" alt="{{general.nome}}" data-lado="{{@index}}" {{#if @root.gm}}data-tooltip="T20BM.Generais.MenuDica"{{/if}} {{#if general.podeVer}}data-action="abrirFicha" data-uuid="{{general.uuid}}"{{/if}}>
					{{else}}
					<span class="t20bm-token general vazio" data-lado="{{@index}}"></span>
					{{/if}}
					<div class="t20bm-comando-nomes">
						<span class="t20bm-sobretitulo">{{localize "T20BM.Configurador.General"}}</span>
						<span class="t20bm-nome-general">{{#if general}}{{general.nome}}{{else}}—{{/if}}</span>
						{{#if substituto}}
						<span class="t20bm-sobretitulo">{{localize "T20BM.Modal.Substituto"}}</span>
						<span class="t20bm-substituto">
							<img class="t20bm-token substituto {{#if substituto.podeVer}}clicavel{{/if}}" src="{{substituto.img}}" alt="" {{#if substituto.podeVer}}data-action="abrirFicha" data-uuid="{{substituto.uuid}}"{{/if}}>
							{{substituto.nome}}
						</span>
						{{/if}}
					</div>
				</div>

				<div class="t20bm-presencas">
					<div class="t20bm-presenca personalidades">
						<span class="t20bm-sobretitulo">{{localize "T20BM.Modal.Personalidades"}}</span>
						<div class="t20bm-fila">
							{{#each personalidades}}
							<img class="t20bm-token personalidade {{#if podeVer}}clicavel{{/if}}" src="{{img}}" alt="{{nome}}" data-tooltip="{{nome}}" {{#if podeVer}}data-action="abrirFicha" data-uuid="{{uuid}}"{{/if}}>
							{{else}}
							<span class="t20bm-nenhum">—</span>
							{{/each}}
						</div>
					</div>
					<div class="t20bm-presenca estandartes">
						<span class="t20bm-sobretitulo">{{localize "T20BM.Configurador.Estandartes"}}</span>
						<div class="t20bm-fila">
							{{#each estandartes}}
							{{#if img}}
							<img class="t20bm-token estandarte {{#if carregado}}carregado{{/if}}" src="{{img}}" alt="{{nome}}" data-tooltip="{{nome}}">
							{{else}}
							<span class="t20bm-token estandarte vazio" data-tooltip="{{nome}}"><i class="fa-solid fa-flag"></i></span>
							{{/if}}
							{{else}}
							<span class="t20bm-nenhum">—</span>
							{{/each}}
						</div>
					</div>
				</div>

				{{#if teste}}
				<section class="t20bm-teste-general {{#if teste.venceu}}venceu{{/if}} {{#if @root.transicaoGenerais}}entrando{{/if}}">
					<div class="t20bm-teste-general-conteudo">
					<span class="t20bm-sobretitulo">{{localize "T20BM.Generais.Composicao"}}</span>
					<ul class="t20bm-composicao">
						{{#each teste.itens}}<li><b>{{valorTxt}}</b> {{texto}}</li>{{/each}}
					</ul>
					<div class="t20bm-teste-rodape">
					<div class="t20bm-composicao-total"><span>{{localize "T20BM.Generais.Total"}}</span><b>{{teste.totalTxt}}</b></div>
					{{#if teste.rolagem}}
					<div class="t20bm-rolagem-general">
						<span>1d20 <b>{{teste.rolagem.d20}}</b> {{teste.rolagem.bonusTxt}} =</span>
						<strong>{{teste.rolagem.total}}</strong>
						{{#if teste.venceu}}<span class="t20bm-venceu"><i class="fa-solid fa-trophy"></i> {{localize "T20BM.Generais.Vencedor"}}</span>{{/if}}
					</div>
					{{else if teste.podeRolar}}
					<button type="button" class="t20bm-principal t20bm-rolar-general" data-action="rolarGeneral" data-lado="{{teste.lado}}" {{#if @root.ocupado}}disabled{{/if}} {{#if @root.rolagemDoJogador}}disabled{{/if}}>
						<i class="fa-solid fa-dice-d20"></i> {{localize "T20BM.Generais.Rolar" bonus=teste.totalTxt}}
					</button>
					{{else}}
					<span class="t20bm-aguardando"><i class="fa-solid fa-hourglass-half"></i> {{localize "T20BM.Generais.Aguardando" nome=teste.quem}}</span>
					{{/if}}
					</div>
					</div>
				</section>
				{{/if}}
				<footer class="t20bm-carrossel">
					{{#each modificadores}}
					<span class="t20bm-carrossel-item {{#if @first}}ativo{{/if}}">{{nome}} <small>{{valor}}</small></span>
					{{else}}
					<span class="t20bm-carrossel-item ativo t20bm-nenhum">{{localize "T20BM.Modal.SemModificadores"}}</span>
					{{/each}}
				</footer>
			</article>
			{{/each}}
		</section>

		{{#if mostrarSecoesTurno}}
		<div class="t20bm-secoes-turno {{#if transicaoGenerais}}saindo{{/if}}">
		{{!-- ============ Progresso do turno ============ --}}
		<section class="t20bm-progresso">
			<span class="t20bm-sobretitulo">{{localize "T20BM.Modal.Progresso"}}</span>
			<ol class="t20bm-etapas">
				{{#each etapas}}
				<li class="t20bm-etapa {{#if feita}}feita{{/if}} {{#if atual}}atual{{/if}}">
					<span class="t20bm-etapa-marca">{{#if feita}}<i class="fa-solid fa-check"></i>{{else}}{{numero}}{{/if}}</span>
					<span class="t20bm-etapa-nome">{{nome}}</span>
				</li>
				{{/each}}
			</ol>
		</section>

		{{!-- ============ Campo de batalha ============ --}}
		<section class="t20bm-campo">
			<h2>{{localize "T20BM.Modal.CampoDeBatalha"}}</h2>
			<div class="t20bm-areas" style="{{estiloCampo}}">
				{{#each areas}}
				<div class="t20bm-area-campo {{#if destaque}}destaque{{/if}}" data-area="{{indice}}">
					{{#if @root.sorteiosDoMestre}}{{#if ocupada}}
					<div class="t20bm-area-acoes">
						<button type="button" class="t20bm-mini" data-action="sortearInimigo" data-area="{{indice}}" data-tooltip="T20BM.Evento.SortearInimigo" {{#if @root.ocupado}}disabled{{/if}}><i class="fa-solid fa-skull"></i></button>
						{{#if @root.posicionamentoAvancado}}
						<select class="t20bm-ajuste" data-resolucao="ajuste" data-area="{{indice}}" data-tooltip="T20BM.Evento.Ajuste">
							<option value="-2" {{#if (eq ajuste -2)}}selected{{/if}}>−2</option>
							<option value="0" {{#if (eq ajuste 0)}}selected{{/if}}>±0</option>
							<option value="2" {{#if (eq ajuste 2)}}selected{{/if}}>+2</option>
						</select>
						{{/if}}
						<button type="button" class="t20bm-mini" data-action="sortearEvento" data-area="{{indice}}" data-tooltip="T20BM.Evento.SortearEvento" {{#if @root.ocupado}}disabled{{/if}}><i class="fa-solid fa-dice-d20"></i></button>
					</div>
					{{/if}}{{/if}}
					<span class="t20bm-romano">{{romano}}</span>
					<h3>{{nome}}</h3>
					<span class="t20bm-sobretitulo">{{subtitulo}}</span>
					{{#if evento}}<span class="t20bm-area-evento" data-tooltip="{{evento.total}}"><i class="fa-solid fa-dice-d20"></i> {{evento.nome}} <b>{{bonusTxt}}</b></span>{{/if}}
					{{#if inimigo}}<span class="t20bm-area-inimigo {{#if inimigo.podeVer}}clicavel{{/if}}" {{#if inimigo.podeVer}}data-action="abrirFicha" data-uuid="{{inimigo.uuid}}" data-tooltip="T20BM.Evento.AbrirFichaInimigo"{{/if}}>{{#if inimigo.img}}<img src="{{inimigo.img}}" alt="">{{/if}} {{inimigo.nome}}</span>{{/if}}
					<div class="t20bm-herois">
						{{#each herois}}
						<span class="t20bm-heroi {{#if morto}}morto{{/if}}">
						{{#if morto}}<i class="fa-solid fa-skull t20bm-caveira" data-tooltip="T20BM.Herois.Morto"></i>{{/if}}
						{{#if estandarte}}<i class="fa-solid fa-flag t20bm-bandeira" data-tooltip="T20BM.Evento.SeguraEstandarte"></i>{{/if}}
						<img class="t20bm-token heroi {{#if podeVer}}clicavel{{/if}} {{#if arrastavel}}arrastavel{{/if}}" src="{{img}}" alt="{{nome}}" data-tooltip="{{nome}}" data-heroi="{{uuid}}" {{#if arrastavel}}draggable="true" data-destinos="{{destinos}}"{{/if}} {{#if podeVer}}data-action="abrirFicha" data-uuid="{{uuid}}"{{/if}}>
						</span>
						{{/each}}
					</div>
				</div>
				{{/each}}
			</div>
		</section>

		{{!-- ============ Resolução do evento ============ --}}
		{{#if mostrarResolucao}}
		<section class="t20bm-resolucao">
			<header>
				<h2>{{localize "T20BM.Evento.Resolucao"}}</h2>
				<span class="t20bm-resolucao-total">{{localize "T20BM.Evento.BonusTotal"}} <b>{{bonusEventoTxt}}</b></span>
			</header>
			{{#each resolucoes}}
			<div class="t20bm-resolucao-linha">
				<div class="t20bm-resolucao-info">
					<span class="t20bm-sobretitulo">{{area}}</span>
					<strong>{{evento.nome}}</strong>
					<small>{{mecanica}}</small>
				</div>
				<div class="t20bm-resolucao-campos">
					{{#if campos.dano}}<label>{{localize "T20BM.Evento.Dano"}} <input type="number" min="0" step="1" data-resolucao="dano" data-area="{{indice}}" value="{{evento.dano}}" placeholder="0" {{#unless @root.editaResolucao}}disabled{{/unless}}></label>{{/if}}
					{{#if campos.danoLider}}<label>{{localize "T20BM.Evento.DanoLider"}} <input type="number" min="0" step="1" data-resolucao="danoLider" data-area="{{indice}}" value="{{evento.danoLider}}" placeholder="0" {{#unless @root.editaResolucao}}disabled{{/unless}}></label>{{/if}}
					{{#if campos.danoOficial}}<label>{{localize "T20BM.Evento.DanoOficial"}} <input type="number" min="0" step="1" data-resolucao="danoOficial" data-area="{{indice}}" value="{{evento.danoOficial}}" placeholder="0" {{#unless @root.editaResolucao}}disabled{{/unless}}></label>{{/if}}
					{{#if campos.teste}}<label class="t20bm-check"><input type="checkbox" data-resolucao="teste" data-area="{{indice}}" {{#if evento.teste}}checked{{/if}} {{#unless @root.editaResolucao}}disabled{{/unless}}> {{localize "T20BM.Evento.TestePassou"}}</label>{{/if}}
					{{#if campos.bonusManual}}<label>{{localize "T20BM.Evento.BonusManual"}} <input type="number" step="1" data-resolucao="bonusManual" data-area="{{indice}}" value="{{evento.bonusManual}}" placeholder="—" {{#unless @root.editaResolucao}}disabled{{/unless}}></label>{{/if}}
					{{#if campos.estandarte}}
					<span class="t20bm-resolucao-estandarte">
						{{#each herois}}
						<button type="button" class="t20bm-chip {{#if estandarte}}ativo{{/if}}" {{#if @root.editaResolucao}}data-action="estandarte" data-heroi="{{uuid}}"{{else}}disabled{{/if}}><i class="fa-solid fa-flag"></i> {{nome}}</button>
						{{/each}}
					</span>
					{{/if}}
					{{#if campos.general}}
					{{#if evento.generalDerrotado}}
					<span class="t20bm-resolucao-nota"><i class="fa-solid fa-crown"></i> {{localize "T20BM.Evento.GeneralDerrotadoNota" pontos=evento.generalDerrotado.pontos penalidade=evento.generalDerrotado.penalidade}}</span>
					{{else if @root.editaResolucao}}
					<button type="button" data-action="generalDerrotado" data-area="{{indice}}" {{#if @root.ocupado}}disabled{{/if}}><i class="fa-solid fa-crown"></i> {{localize "T20BM.Evento.GeneralDerrotado"}}</button>
					{{else}}
					<span class="t20bm-resolucao-nota">{{localize "T20BM.Evento.CombateNormal"}}</span>
					{{/if}}
					{{/if}}
				</div>
				<span class="t20bm-resolucao-bonus" data-tooltip="T20BM.Evento.BonusDaArea">{{bonusTxt}}</span>
			</div>
			{{/each}}
		</section>
		{{/if}}

		</div>
		{{/if}}

		{{!-- ============ Rodapé ============ --}}
		<footer class="t20bm-rodape-tabuleiro">
			<div>
				<h2>{{mensagemTitulo}}</h2>
				<p>{{mensagemTexto}}</p>
				{{#if prontos.mostrar}}
				<div class="t20bm-prontos">
					<span class="t20bm-sobretitulo">{{localize "T20BM.Preparacao.Prontos" quantos=prontos.quantos total=prontos.total}}</span>
					<ul>
						{{#each prontos.jogadores}}<li class="{{#if pronto}}pronto{{/if}}"><i class="fa-solid {{#if pronto}}fa-circle-check{{else}}fa-hourglass-half{{/if}}"></i> {{nome}}</li>{{/each}}
					</ul>
					{{#if prontos.euObrigatorio}}
					{{#if prontos.euPronto}}
					<button type="button" data-action="pronto" data-pronto="false"><i class="fa-solid fa-rotate-left"></i> {{localize "T20BM.Preparacao.Desfazer"}}</button>
					{{else}}
					<button type="button" class="t20bm-principal" data-action="pronto" data-pronto="true"><i class="fa-solid fa-check"></i> {{prontos.rotuloConcluir}}</button>
					{{/if}}
					{{/if}}
				</div>
				{{/if}}
				{{#if movimento.mostrar}}
				<div class="t20bm-movimento">
					{{#each movimento.opcoes}}
					<div class="t20bm-movimento-linha">
						<span class="t20bm-sobretitulo">{{rotulo}}</span>
						{{#if recuar}}<button type="button" data-action="mover" data-heroi="{{uuid}}" data-para="{{paraRecuar}}"><i class="fa-solid fa-arrow-left"></i> {{localize "T20BM.Posicionamento.Recuar"}}</button>{{/if}}
						{{#if avancar}}<button type="button" data-action="mover" data-heroi="{{uuid}}" data-para="{{paraAvancar}}">{{localize "T20BM.Posicionamento.Avancar"}} <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
					</div>
					{{/each}}
					<span class="t20bm-movimento-dica">{{localize "T20BM.Posicionamento.Dica"}}</span>
				</div>
				{{/if}}
			</div>
			{{#if gm}}
			<div class="t20bm-conducao">
				{{#if pre}}
				{{#if preBatalha}}
				<button type="button" data-action="terreno" {{#if ocupado}}disabled{{/if}} data-tooltip="T20BM.Modal.TerrenoDica"><i class="fa-solid fa-mountain-sun"></i> {{localize "T20BM.Teste.Terreno"}}</button>
				<button type="button" data-action="motivacao" {{#if ocupado}}disabled{{/if}} data-tooltip="T20BM.Modal.MotivacaoDica"><i class="fa-solid fa-bullhorn"></i> {{localize "T20BM.Teste.Motivacao"}}</button>
				{{/if}}
				<button type="button" class="t20bm-principal" data-action="avancar" {{#if ocupado}}disabled{{/if}}>{{localize "T20BM.Modal.Iniciar"}} <i class="fa-solid fa-arrow-right"></i></button>
				{{else}}
				{{#if podeResetarGenerais}}<button type="button" data-action="resetarGenerais" {{#if ocupado}}disabled{{/if}}><i class="fa-solid fa-dice"></i> {{localize "T20BM.Generais.Resetar"}}</button>{{/if}}
				{{#if podeDeclarar}}<button type="button" class="t20bm-icone" data-action="declararVencedor" data-tooltip="T20BM.Fim.DeclararDica"><i class="fa-solid fa-flag-checkered"></i></button>{{/if}}
				{{#if podeVoltar}}<button type="button" data-action="voltar" {{#if ocupado}}disabled{{/if}}><i class="fa-solid fa-arrow-left"></i> {{localize "T20BM.Modal.Voltar"}}</button>{{/if}}
				<button type="button" class="t20bm-principal" data-action="avancar" {{#if ocupado}}disabled{{/if}}>{{localize "T20BM.Modal.Avancar"}} <i class="fa-solid fa-arrow-right"></i></button>
				{{/if}}
			</div>
			{{/if}}
		</footer>
		{{/if}}
	</div>
</div>
